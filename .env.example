# Copy to .env and fill in. NEVER commit the real .env.
#
#   cp .env.example .env

# From @BotFather in Telegram.
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# From tools/get_chat_id.py after messaging your bot.
TELEGRAM_CHAT_ID=987654321

# How often to check, in seconds. 600 = 10 minutes.
POLL_SECONDS=600

# Extra random delay added to each interval, in seconds.
JITTER_SECONDS=60

# How many weeks ahead to scan. Allocate publishes about two.
WEEKS_TO_SCAN=3

# ------------------------------------------------------------
# Organisation-specific settings. Required.
# ------------------------------------------------------------

# Tenant code: the path segment after EmployeeOnlineHealth/
# in your organisation's Loop URL.
ALLOCATE_TENANT=YOURTENANT

# Unit and grade exactly as Loop displays them.
TARGET_UNIT=Your Unit Name
TARGET_GRADE=Your Grade Name

# Optional wording used in alerts.
SITE_NAME=NHS Hospital
STAFF_BANK_NAME=Staff Bank

# Standard number of bank shifts per Monday-Sunday week.
WEEKLY_LIMIT=4
